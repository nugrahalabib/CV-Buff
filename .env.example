# ── CV-Buff environment template ──
# Copy to `.env` and fill in. The real `.env` is gitignored (never commit secrets).
# All variables below are SERVER-ONLY — do NOT prefix with VITE_ (that would leak to the client).

# better-auth session secret (sign/encrypt cookies).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public base URL of the app.
#   dev:  http://localhost:1713
#   prod: https://cv.agentbuff.id
BETTER_AUTH_URL=http://localhost:1713

# Postgres connection (server-only) for auth + per-user CV storage. Examples:
#   local dev via SSH tunnel:  postgresql://cvbuff_user:PASS@localhost:55432/cvbuff
#   app on the VPS host:        postgresql://cvbuff_user:PASS@localhost:5432/cvbuff
#   app in Docker (compose):   postgresql://cvbuff_user:PASS@host.docker.internal:5432/cvbuff
DATABASE_URL=postgresql://cvbuff_user:PASS@localhost:5432/cvbuff

# Google OAuth credentials — get these from Google Cloud Console (see docs/AUTH.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lambda fontconfig path (used by the serverless PDF export).
FONTCONFIG_PATH=/var/task/fonts
